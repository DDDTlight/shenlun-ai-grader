# ===== 环境变量与密钥 =====
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
config/secrets.*

# ===== 基准集（本地私有，不得外传）=====
# 含机构参考答案与人工标注，属机构教研成果 + 个人标注数据。
# 当前基准集不在本仓库（在 申论批改系统/benchmark/），这里是防御性规则 ——
# 万一将来挪进来，也不会被误提交。
benchmark/questions/*/reference.md
benchmark/questions/*/gold.json
benchmark/questions/*/answers/
benchmark/**/*.label.json
benchmark/*.local/

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ===== Node / 前端 =====
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
.nuxt/
out/
dist/
build/
coverage/
.vite/
.cache/

# ===== VSCode / IDE =====
# 整个 .vscode/ 都忽略。
#
# 原来这里有 !.vscode/settings.json 之类的例外，结果把一份指向 conda 的
# 本机编辑器配置提交进去了 —— 而本项目用的是 venv。
# 别人 clone 下来用 VS Code 打开会被误导。
#
# 编辑器配置属于个人偏好，不该由仓库规定。
.vscode/
.idea/
*.swp

# ===== 本地归档（不进仓库，也不该出现在发布包里）=====
# 放被删掉但仍想留着的旧文件，比如 prompts_v1.py。
# 想找回历史版本应该用 git，这里的只是「随手放一下」的便利副本。
_archive/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志、临时文件 =====
*.log
logs/
tmp/
temp/
*.tmp
*.bak